<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>torque_vectoring_pkg</name>
  <version>0.0.1</version>
  <description>Torque vectoring controller for a 4WD electric race car: yaw moment control and per-wheel torque allocation</description>

  <maintainer email="albin.oviktigt@gmail.com">Bulban</maintainer>

  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>eigen</depend>
  <depend>vehicle_params_cpp</depend>
  <depend>fs_msgs</depend>
  <depend>ros2can_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
